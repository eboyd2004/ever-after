# Prisma/PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL=""

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_with_your_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_your_secret_key"
CLERK_SIGN_IN_URL="/sign-in"
CLERK_SIGN_UP_URL="/sign-up"
CLERK_AFTER_SIGN_IN_URL="/dashboard"
CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Server-only URL used in workspace member invitation links. Required in Preview and Production.
APP_URL="http://localhost:3000"

# Workspace invitation email transport
EMAIL_PROVIDER="development"
RESEND_API_KEY=""
EMAIL_FROM="Tied Forever <hello@example.local>"
